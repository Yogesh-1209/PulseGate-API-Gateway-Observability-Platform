# Gateway server port
PORT=3000

# API Keys — comma-separated list of valid keys clients must send
# Add more keys by appending: ,key-another-456
API_KEYS=key-client-abc-123,key-client-xyz-456

# Redis connection (matches the Docker Compose service name)
REDIS_HOST=redis
REDIS_PORT=6379

# Rate limiting: max 20 requests per 60-second window per API key
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# How long (ms) to wait for a backend service before giving up
PROXY_TIMEOUT_MS=5000

# Backend service URLs (matches Docker Compose service names)
USERS_SERVICE_URL=http://users-service:3001
PRODUCTS_SERVICE_URL=http://products-service:3002
